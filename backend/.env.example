# Copy this file to .env and fill in your values.

PORT=5000

# Comma-separated list of frontend origins allowed to call the API
# (only needed when the frontend is hosted separately, e.g. on Vercel).
CLIENT_ORIGIN=http://localhost:5173

# SMTP settings for delivering contact form messages by email.
# Leave blank to save messages to server/data/messages.jsonl instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and an App Password for SMTP_PASS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Where contact messages should be delivered (defaults to SMTP_USER).
CONTACT_TO=
