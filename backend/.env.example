# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# In dev, the Vite frontend runs on http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Contact form email (optional) ---------------------------------
# If SMTP_HOST is left empty, submissions are only written to
# backend/src/data/messages.json and NOT emailed. Fill these in
# (e.g. with Gmail App Password, Resend, SendGrid SMTP, Mailgun, etc.)
# to enable real email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=portfolio@example.com

# Simple shared secret required in the `x-admin-key` header to read
# /api/contact/messages (list of submissions). Change this.
ADMIN_KEY=change-me-please
